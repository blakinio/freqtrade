from __future__ import annotations

from decimal import Decimal

import pytest

from ai_platform.wickhunter.candidate_paper_runtime_operator import (
    ZERO_AUTHORITY,
    CandidatePaperRuntimeOperatorError,
    PublicMarketSnapshot,
    _live_source_state,
    assert_closed_authority_environment,
)
from ai_platform.wickhunter.contracts import SourceHealth


EXPECTED_MARKET_METRICS = {
    "atr_ratio",
    "funding_rate",
    "market_wide_liquidation_intensity",
    "open_interest_usd",
    "quote_volume_24h_usd",
    "spread_bps",
    "trend_return_ratio",
    "volatility_ratio",
    "vwap",
    "vwma",
    "wick_ratio",
}


def test_candidate_paper_runtime_operator_rejects_credentials_and_proxies() -> None:
    for environment in (
        {"BINANCE_API_KEY": "secret"},
        {"HTTPS_PROXY": "http://proxy.invalid"},
    ):
        with pytest.raises(
            CandidatePaperRuntimeOperatorError,
            match="forbidden credential or proxy environment present",
        ):
            assert_closed_authority_environment(environment)

    assert_closed_authority_environment({})


def test_candidate_paper_runtime_operator_publishes_exact_market_contract() -> None:
    snapshot = PublicMarketSnapshot(
        symbol="BTCUSDT",
        observed_at_ms=2_000_000,
        decision_price=Decimal("100"),
        completed_candle_close_ms=1_980_000,
        quote_volume_24h_usd=Decimal("5000000"),
        spread_bps=Decimal("1.25"),
        trend_return_ratio=Decimal("0.02"),
        volatility_ratio=Decimal("0.003"),
        vwap=Decimal("99.5"),
        vwma=Decimal("99.7"),
        wick_ratio=Decimal("0.4"),
        atr_ratio=Decimal("0.01"),
        open_interest_usd=Decimal("2500000"),
        funding_rate=Decimal("0.0001"),
    )

    context = snapshot.market_context(
        market_wide_liquidation_intensity=Decimal("1.5")
    )
    metrics = {metric.name: metric for metric in context.metrics}

    assert set(metrics) == EXPECTED_MARKET_METRICS
    assert tuple(metrics) == tuple(sorted(EXPECTED_MARKET_METRICS))
    assert metrics["spread_bps"].source == "binance-usdm-public-book-ticker"
    assert metrics["atr_ratio"].source == "completed_candle:binance-usdm-public-1m"
    assert metrics["market_wide_liquidation_intensity"].source == (
        "liquid20-live:market-wide"
    )
    assert context.decision_timestamp_ms == 2_000_000
    assert context.completed_candle_close_ms == 1_980_000


def test_candidate_paper_runtime_operator_derives_live_source_health() -> None:
    observed_at_ms = 2_000_000
    healthy = _live_source_state(
        "binance-usdm",
        {
            "configured": True,
            "connected": True,
            "events_written": 3,
            "last_event_received_at_ms": observed_at_ms - 1_000,
            "last_heartbeat_at_ms": observed_at_ms - 500,
        },
        observed_at_ms=observed_at_ms,
        maximum_age_ms=5_000,
    )
    stale = _live_source_state(
        "bybit",
        {
            "configured": True,
            "connected": True,
            "events_written": 3,
            "last_event_received_at_ms": observed_at_ms - 10_000,
            "last_heartbeat_at_ms": observed_at_ms - 500,
        },
        observed_at_ms=observed_at_ms,
        maximum_age_ms=5_000,
    )

    assert healthy.health is SourceHealth.HEALTHY
    assert healthy.coverage_available is True
    assert stale.health is SourceHealth.STALE


def test_candidate_paper_runtime_operator_keeps_zero_authority_closed() -> None:
    assert ZERO_AUTHORITY == {
        "protected_holdout_accessed": False,
        "automatic_promotion_enabled": False,
        "trading_credentials_present": False,
        "order_adapter_present": False,
        "execution_enabled": False,
        "orders_submitted": 0,
        "live_capital_authorized": False,
    }
