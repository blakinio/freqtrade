{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "ai-platform-residual-pytorch-m1-seeded-mlp-generalization-v3",
  "cancel_open_orders_on_exit": true,
  "dry_run": true,
  "dry_run_wallet": 10000,
  "entry_pricing": {
    "check_depth_of_market": {
      "bids_to_ask_delta": 1,
      "enabled": false
    },
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "price_side": "same",
    "use_order_book": true
  },
  "exchange": {
    "ccxt_async_config": {},
    "ccxt_config": {},
    "key": "",
    "name": "kraken",
    "pair_blacklist": [],
    "pair_whitelist": [
      "SOL/USDT",
      "XRP/USDT"
    ],
    "secret": ""
  },
  "exit_pricing": {
    "order_book_top": 1,
    "price_side": "other",
    "use_order_book": true
  },
  "fiat_display_currency": "USD",
  "force_entry_enable": false,
  "freqai": {
    "activate_tensorboard": true,
    "backtest_period_days": 61,
    "continual_learning": false,
    "data_split_parameters": {
      "random_state": 42,
      "shuffle": false,
      "test_size": 0.2
    },
    "enabled": true,
    "feature_parameters": {
      "DI_threshold": 1.0,
      "buffer_train_data_candles": 0,
      "include_corr_pairlist": [
        "SOL/USDT",
        "XRP/USDT"
      ],
      "include_shifted_candles": 2,
      "include_timeframes": [
        "15m",
        "1h",
        "4h"
      ],
      "indicator_periods_candles": [
        14,
        50
      ],
      "label_period_candles": 12,
      "plot_feature_importances": 0,
      "principal_component_analysis": false,
      "shuffle_after_split": false,
      "use_DBSCAN_to_remove_outliers": false,
      "use_SVM_to_remove_outliers": false,
      "weight_factor": 0.9
    },
    "identifier": "ai-platform-residual-pytorch-m1-seeded-mlp-generalization-v3",
    "model_training_parameters": {
      "learning_rate": 0.0003,
      "model_kwargs": {
        "dropout_percent": 0.0,
        "hidden_dim": 64,
        "n_layer": 1
      },
      "research_seed": 42,
      "trainer_kwargs": {
        "batch_size": 64,
        "early_stopping_patience": 0,
        "n_epochs": 3
      }
    },
    "override_exchange_checks": true,
    "purge_old_models": 2,
    "save_backtest_models": true,
    "train_period_days": 90
  },
  "freqaimodel_path": "ai_platform/freqaimodels",
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  },
  "max_open_trades": 2,
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "stake_amount": 100,
  "stake_currency": "USDT",
  "timeframe": "15m",
  "tradable_balance_ratio": 0.95,
  "trading_mode": "spot",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 30
  }
}
