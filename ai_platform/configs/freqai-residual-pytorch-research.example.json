{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "trading_mode": "spot",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "timeframe": "15m",
  "cancel_open_orders_on_exit": true,
  "freqaimodel_path": "ai_platform/freqaimodels",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 30
  },
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": []
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "freqai": {
    "enabled": true,
    "override_exchange_checks": true,
    "purge_old_models": 2,
    "train_period_days": 90,
    "backtest_period_days": 30,
    "save_backtest_models": false,
    "continual_learning": false,
    "identifier": "ai-platform-residual-pytorch-research-v1",
    "feature_parameters": {
      "include_timeframes": [
        "15m",
        "1h",
        "4h"
      ],
      "include_corr_pairlist": [
        "BTC/USDT",
        "ETH/USDT"
      ],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "DI_threshold": 1.0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [
        14,
        50
      ],
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "research_seed": 42,
      "learning_rate": 0.0003,
      "weight_decay": 0.0001,
      "loss_beta": 0.01,
      "trainer_kwargs": {
        "n_epochs": 8,
        "batch_size": 64,
        "early_stopping_patience": 2
      },
      "model_kwargs": {
        "hidden_dim": 128,
        "n_blocks": 3,
        "expansion_factor": 2,
        "dropout_percent": 0.1,
        "residual_scale": 1.0
      }
    }
  },
  "bot_name": "ai-platform-residual-pytorch-research",
  "force_entry_enable": false,
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  }
}
