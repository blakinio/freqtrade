{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "trading_mode": "spot",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "timeframe": "15m",
  "cancel_open_orders_on_exit": true,
  "freqaimodel_path": "ai_platform/freqaimodels",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 30
  },
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": []
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "freqai": {
    "enabled": true,
    "override_exchange_checks": true,
    "purge_old_models": 2,
    "train_period_days": 90,
    "backtest_period_days": 122,
    "save_backtest_models": false,
    "live_retrain_hours": 6,
    "continual_learning": false,
    "identifier": "ai-platform-rl-research-v1",
    "feature_parameters": {
      "include_timeframes": [
        "15m",
        "1h",
        "4h"
      ],
      "include_corr_pairlist": [
        "BTC/USDT",
        "ETH/USDT"
      ],
      "include_shifted_candles": 2,
      "DI_threshold": 0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [
        14,
        50
      ],
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "seed": 42,
      "n_steps": 128,
      "batch_size": 64
    },
    "rl_config": {
      "train_cycles": 1,
      "add_state_info": false,
      "max_trade_duration_candles": 96,
      "max_training_drawdown_pct": 0.2,
      "cpu_count": 1,
      "model_type": "PPO",
      "policy_type": "MlpPolicy",
      "drop_ohlc_from_features": true,
      "randomize_starting_position": false,
      "progress_bar": false,
      "net_arch": [
        64,
        64
      ],
      "training_fee": 0.002,
      "model_reward_parameters": {
        "rr": 1.0,
        "profit_aim": 0.01
      }
    }
  },
  "bot_name": "ai-platform-rl-research",
  "force_entry_enable": false,
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  }
}
