{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ai-platform-experiment-schema-v1",
    "title": "AI Platform Experiment Manifest v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "experiment_id",
        "description",
        "config",
        "strategy",
        "strategy_path",
        "freqai_model",
        "timerange",
        "download_timerange",
        "pairs",
        "timeframes",
        "fee",
        "output_root"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "experiment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "config": {
            "type": "string",
            "minLength": 1
        },
        "strategy": {
            "type": "string",
            "minLength": 1
        },
        "strategy_path": {
            "type": "string",
            "minLength": 1
        },
        "freqai_model": {
            "type": "string",
            "minLength": 1
        },
        "timerange": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{8}$"
        },
        "download_timerange": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{8}$"
        },
        "pairs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "timeframes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "fee": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.05
        },
        "output_root": {
            "type": "string",
            "minLength": 1
        }
    }
}
