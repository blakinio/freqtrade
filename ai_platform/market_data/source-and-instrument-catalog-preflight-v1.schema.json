      "type": "object"
    },
    "document_id": {
      "const": "market-data-source-instrument-preflight-v1"
    },
    "document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "foundation_catalog": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "ai_platform/market_data/source-catalog-v1.json"
