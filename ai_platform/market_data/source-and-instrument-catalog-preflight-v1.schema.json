{
  "$defs": {
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "minLength": 1,
          "type": "string"
        },
        "base_asset": {
          "minLength": 1,
          "type": "string"
        },
        "contract_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_value_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at_ms": {
          "type": [
            "string",
            "null"
          ]
        },
        "listed_at_ms": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity_step": {
          "minLength": 1,
          "type": "string"
        },
        "quote_asset": {
          "minLength": 1,
          "type": "string"
        },
        "settlement_asset": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "ready_with_rule",
            "blocked"
          ]
        },
        "tick_size": {
          "minLength": 1,
          "type": "string"
        },
        "unresolved": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "base_asset",
        "quote_asset",
        "settlement_asset",
        "contract_value",
        "contract_value_unit",
        "tick_size",
        "quantity_step",
        "active",
        "listed_at_ms",
        "expires_at_ms",
        "unresolved"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "catalog_endpoint": {
          "pattern": "^https://",
          "type": "string"
        },
        "constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "decision": {
          "minLength": 1,
          "type": "string"
        },
        "exchange": {
          "enum": [
            "binance",
            "bybit",
            "okx"
          ]
        },
        "mapping": {
          "$ref": "#/$defs/mapping"
        },
        "market_types": {
          "items": {
            "enum": [
              "spot",
              "perpetual",
              "dated_future"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "official_docs": {
          "items": {
            "pattern": "^https://",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "pagination": {
          "minLength": 1,
          "type": "string"
        },
        "sample_evidence": {
          "const": "official_documentation_example"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "websocket_endpoint": {
          "pattern": "^wss://",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "exchange",
        "market_types",
        "catalog_endpoint",
        "pagination",
        "websocket_endpoint",
        "constraints",
        "mapping",
        "sample_evidence",
        "decision",
        "official_docs"
      ],
      "type": "object"
    }
  },
