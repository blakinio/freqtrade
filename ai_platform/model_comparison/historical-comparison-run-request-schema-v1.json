{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.local/ai-platform/model-comparison/historical-comparison-run-request-schema-v1.json",
  "title": "AI Platform Phase 6 historical model comparison run request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "execution_mode",
    "comparison_id",
    "comparison_contract",
    "comparison_contract_sha256",
    "selection_policy",
    "selection_policy_sha256",
    "strategy",
    "strategy_sha256",
    "models",
    "training_window",
    "tuning_window",
    "historical_oos_timerange",
    "historical_oos_status",
    "download_timerange",
    "protected_final_holdout",
    "execution_commit_policy",
    "trigger_change_policy",
    "final_holdout_used",
    "retuning_allowed",
    "model_parameter_tuning_allowed",
    "feature_changes_allowed",
    "promotion_allowed",
    "live_trading_allowed",
    "profitability_claim_allowed",
    "unseen_final_evidence_claim_allowed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"const": "freqai-lightgbm-vs-xgboost-historical-comparison-run-v1"},
    "execution_mode": {"const": "one_shot_historical_model_comparison"},
    "comparison_id": {"const": "freqai-lightgbm-vs-xgboost-v1"},
    "comparison_contract": {
      "const": "ai_platform/model_comparison/lightgbm-vs-xgboost-v1.json"
    },
    "comparison_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_policy": {"const": "ai_platform/model_comparison/selection-policy-v1.json"},
    "selection_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strategy": {"const": "ai_platform/strategies/AiPhase52ExitStrategy.py"},
    "strategy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "LightGBMRegressor"},
        {"const": "XGBoostRegressor"}
      ],
      "items": false
    },
    "training_window": {"const": "20251201-20260228"},
    "tuning_window": {"const": "20260301-20260430"},
    "historical_oos_timerange": {"const": "20260501-20260630"},
    "historical_oos_status": {"const": "consumed_historical_oos"},
    "download_timerange": {"const": "20250801-20260630"},
    "protected_final_holdout": {"const": "20260801-20260930"},
    "execution_commit_policy": {"const": "pull_request_head_sha"},
    "trigger_change_policy": {"const": "request_file_only"},
    "final_holdout_used": {"const": false},
    "retuning_allowed": {"const": false},
    "model_parameter_tuning_allowed": {"const": false},
    "feature_changes_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "live_trading_allowed": {"const": false},
    "profitability_claim_allowed": {"const": false},
    "unseen_final_evidence_claim_allowed": {"const": false}
  }
}
