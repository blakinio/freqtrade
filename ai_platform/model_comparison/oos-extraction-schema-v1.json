{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oteryn.local/ai-platform/model-comparison/oos-extraction-schema-v1.json",
  "title": "AI Platform model comparison strict OOS extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extractor_id",
    "metric_semantics_id",
    "oos_trade_boundary_id",
    "model_type",
    "experiment_identity",
    "strategy",
    "source",
    "scoring_window",
    "starting_balance",
    "counts",
    "metrics",
    "stability_evidence",
    "included_trade_evidence",
    "excluded_trade_evidence",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "extractor_id": {"const": "freqai-model-comparison-oos-extractor-v1"},
    "metric_semantics_id": {"const": "freqai-model-comparison-metrics-v1"},
    "oos_trade_boundary_id": {"const": "freqai-model-comparison-oos-trade-boundary-v1"},
    "model_type": {"enum": ["LightGBMRegressor", "XGBoostRegressor"]},
    "experiment_identity": {"type": "string", "minLength": 1},
    "strategy": {"const": "AiPhase52ExitStrategy"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_sha256", "stats_member"],
      "properties": {
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stats_member": {"type": "string", "minLength": 1}
      }
    },
    "scoring_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timerange", "start_inclusive", "end_exclusive", "timezone", "source_status"],
      "properties": {
        "timerange": {"const": "20260501-20260630"},
        "start_inclusive": {"const": "2026-05-01T00:00:00Z"},
        "end_exclusive": {"const": "2026-07-01T00:00:00Z"},
        "timezone": {"const": "UTC"},
        "source_status": {"const": "consumed_historical_oos"}
      }
    },
    "starting_balance": {"type": "number", "exclusiveMinimum": 0},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_trades",
        "included_trades",
        "excluded_trades",
        "excluded_pre_window_open_trades",
        "excluded_post_window_close_trades",
        "included_force_exit_trades"
      ],
      "properties": {
        "input_trades": {"type": "integer", "minimum": 0},
        "included_trades": {"type": "integer", "minimum": 0},
        "excluded_trades": {"type": "integer", "minimum": 0},
        "excluded_pre_window_open_trades": {"type": "integer", "minimum": 0},
        "excluded_post_window_close_trades": {"type": "integer", "minimum": 0},
        "included_force_exit_trades": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profit", "drawdown", "trades", "stability"],
      "properties": {
        "profit": {"type": "number"},
        "drawdown": {"type": "number", "minimum": 0},
        "trades": {"type": "integer", "minimum": 0},
        "stability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stability_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated_folds", "profitable_folds", "fold_trade_counts", "fold_profits"],
      "properties": {
        "evaluated_folds": {"const": 2},
        "profitable_folds": {"type": "integer", "minimum": 0, "maximum": 2},
        "fold_trade_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["2026-05", "2026-06"],
          "properties": {
            "2026-05": {"type": "integer", "minimum": 0},
            "2026-06": {"type": "integer", "minimum": 0}
          }
        },
        "fold_profits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["2026-05", "2026-06"],
          "properties": {
            "2026-05": {"type": "number"},
            "2026-06": {"type": "number"}
          }
        }
      }
    },
    "included_trade_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/includedTrade"}
    },
    "excluded_trade_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/excludedTrade"}
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_holdout_used",
        "retuning_allowed",
        "promotion_allowed",
        "profitability_claim_allowed"
      ],
      "properties": {
        "final_holdout_used": {"const": false},
        "retuning_allowed": {"const": false},
        "promotion_allowed": {"const": false},
        "profitability_claim_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "tradeBase": {
      "type": "object",
      "required": ["source_index", "open_date", "close_date", "profit_abs", "exit_reason"],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0},
        "open_date": {"type": "string", "minLength": 1},
        "close_date": {"type": "string", "minLength": 1},
        "profit_abs": {"type": "number"},
        "exit_reason": {"type": "string", "minLength": 1}
      }
    },
    "includedTrade": {
      "allOf": [
        {"$ref": "#/$defs/tradeBase"},
        {"type": "object", "additionalProperties": false}
      ]
    },
    "excludedTrade": {
      "allOf": [
        {"$ref": "#/$defs/tradeBase"},
        {
          "type": "object",
          "required": ["exclusion_reasons"],
          "properties": {
            "exclusion_reasons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["pre_window_open", "post_window_close"]}
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
