      "minimum_profit": "gates.minimum_holdout_profit",
      "maximum_drawdown": "gates.maximum_holdout_drawdown",
      "minimum_stability": "gates.minimum_profitable_folds / metric_semantics.metrics.stability.evaluated_folds"
