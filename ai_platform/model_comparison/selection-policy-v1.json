{
  "schema_version": 1,
  "selection_policy_id": "freqai-model-comparison-selection-v1",
  "comparison_contract": "ai_platform/model_comparison/lightgbm-vs-xgboost-v1.json",
  "metric_semantics": "ai_platform/model_comparison/metric-semantics-v1.json",
  "oos_trade_boundary": "ai_platform/model_comparison/oos-trade-boundary-v1.json",
  "extraction_schema": "ai_platform/model_comparison/oos-extraction-schema-v1.json",
  "baseline_validation_plan": "ai_platform/validation/baseline-validation-v1.json",
  "models": {
    "incumbent": "LightGBMRegressor",
    "challenger": "XGBoostRegressor"
  },
  "eligibility_gates": {
    "minimum_trades": 10,
    "minimum_profit": 0.0,
    "maximum_drawdown": 0.25,
    "minimum_stability": 0.5,
    "provenance": {
