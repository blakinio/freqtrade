#!/bin/sh
set -eu

release_dir=/run/portal-release
release_file="$release_dir/release"
application_ready="$release_dir/application-ready"
log_probe_ready="$release_dir/log-probe-ready"
log_probe_begin=PORTAL_LOG_BOUND_PROBE_BEGIN
log_probe_end=PORTAL_LOG_BOUND_PROBE_END
config_file=/runtime/config/config.json

probe_bytes=${PORTAL_LOG_PROBE_BYTES:?PORTAL_LOG_PROBE_BYTES is required}
case "$probe_bytes" in
    ''|*[!0-9]*)
        echo "invalid PORTAL_LOG_PROBE_BYTES" >&2
        exit 64
        ;;
esac
if [ "$probe_bytes" -le 0 ]; then
    echo "PORTAL_LOG_PROBE_BYTES must be positive" >&2
    exit 64
fi

mkdir -p "$release_dir"
printf '%s\n' "$log_probe_begin"
blocks=$(( (probe_bytes + 4095) / 4096 ))
dd if=/dev/zero bs=4096 count="$blocks" 2>/dev/null | tr '\000' 'L'
printf '\n%s\n' "$log_probe_end"
: > "$log_probe_ready"

while [ ! -f "$release_file" ]; do
    sleep 0.05
done

python - "$config_file" <<'PY'
import json
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
try:
    config = json.loads(config_path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"Portal runtime release refused: unreadable canonical config: {exc}") from exc

if config.get("dry_run") is not True:
    raise SystemExit("Portal runtime release refused: PAPER dry_run=true is required")
exchange = config.get("exchange")
if not isinstance(exchange, dict):
    raise SystemExit("Portal runtime release refused: exchange configuration is required")
for field in ("key", "secret", "password", "uid"):
    value = exchange.get(field)
    if value not in (None, ""):
        raise SystemExit(
            f"Portal runtime release refused: private exchange credential field {field!r} must be absent"
        )
print("Portal PAPER dry-run configuration attested", flush=True)
PY

child_pid=""
relay_pid=""
startup_pipe="$release_dir/application-output"
forward_signal() {
    if [ -n "$child_pid" ]; then
        kill -TERM "$child_pid" 2>/dev/null || true
    fi
}
trap forward_signal TERM INT HUP

rm -f "$startup_pipe"
mkfifo "$startup_pipe"
while IFS= read -r line; do
    printf '%s\n' "$line"
    case "$line" in
        *"Bot heartbeat."*"state='RUNNING'"*)
            : > "$application_ready"
            ;;
    esac
done < "$startup_pipe" &
relay_pid=$!

"$@" > "$startup_pipe" 2>&1 &
child_pid=$!
set +e
wait "$child_pid"
status=$?
wait "$relay_pid"
set -e
rm -f "$startup_pipe"
exit "$status"
