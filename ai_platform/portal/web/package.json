{
  "name": "@freqtrade/ai-portal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test --project=chromium-desktop",
    "test:e2e:smoke": "playwright test --project=chromium-desktop --grep @smoke",
    "test:e2e:critical": "playwright test --project=chromium-desktop --grep @critical",
    "test:e2e:regression": "playwright test --project=chromium-desktop --project=chromium-accessibility --project=chromium-resilience --project=firefox-desktop --project=webkit-desktop --project=mobile-chrome --project=mobile-safari",
    "test:e2e:cross-browser": "playwright test --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop --grep @cross-browser",
    "test:e2e:security": "playwright test --project=chromium-desktop --grep @security",
    "test:market-evidence-auth": "node --test e2e/market-evidence-production-auth.test.mjs && node --test e2e/response-cache-production.test.mjs",
    "test:response-cache-production": "node --test e2e/response-cache-production.test.mjs",
    "test:liquid20-auth": "node --test e2e/liquid20-production-auth.test.mjs",
    "test:e2e:a11y": "playwright test --project=chromium-accessibility",
    "test:e2e:responsive": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:resilience": "playwright test --project=chromium-resilience",
    "test:e2e:stability": "playwright test --project=chromium-stability --repeat-each=10 --workers=1",
    "test:e2e:soak": "playwright test --project=chromium-soak --repeat-each=25 --workers=1",
    "test:e2e:debug": "playwright test --project=chromium-desktop --debug",
    "test:e2e:report": "playwright show-report artifacts/playwright-report"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
