{
  "schema_version": 1,
  "policy_id": "liquidation-data-only-staging-v1",
  "endpoint": "wss://stream.bybit.com/v5/public/linear",
  "symbols": [
    "BTCUSDT",
    "ETHUSDT"
  ],
  "clock": {
    "server_time_url": "https://api.bybit.com/v5/market/time",
    "maximum_absolute_skew_ms": 2000
  },
  "modes": {
    "smoke": {
      "minimum_duration_seconds": 20,
      "minimum_messages_received": 1,
      "maximum_parse_failures": 0,
      "minimum_availability_ratio": 0.8,
      "maximum_disconnects_per_hour": 0,
      "maximum_duplicate_ratio": 1.0,
      "latency_threshold_ms": 5000,
      "maximum_latency_over_threshold_ratio": 1.0,
      "minimum_latency_samples": 0,
      "minimum_events_per_symbol": 0,
      "require_clock_synchronized": true,
      "require_new_output": true,
      "require_collector_commit": true
    },
    "acceptance": {
      "minimum_duration_seconds": 86400,
      "minimum_messages_received": 1,
      "maximum_parse_failures": 0,
      "minimum_availability_ratio": 0.995,
      "maximum_disconnects_per_hour": 2.0,
      "maximum_duplicate_ratio": 0.01,
      "latency_threshold_ms": 5000,
      "maximum_latency_over_threshold_ratio": 0.01,
      "minimum_latency_samples": 10,
      "minimum_events_per_symbol": 1,
      "require_clock_synchronized": true,
      "require_new_output": true,
      "require_collector_commit": true
    }
  }
}
