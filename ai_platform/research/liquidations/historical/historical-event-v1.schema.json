{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freqtrade.local/schemas/liquid20/historical-event-v1.schema.json",
  "title": "Liquid20 historical liquidation event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "symbol",
    "liquidated_position_side",
    "occurred_at_ms",
    "available_at_ms",
    "available_at_semantics",
    "price",
    "quantity",
    "notional_usd",
    "source_event_id",
    "provider_event_id",
    "dataset_origin",
    "historical_provider",
    "provider_exchange",
    "provider_timestamp_us",
    "provider_local_timestamp_us",
    "native_channel",
    "semantic_era",
    "import_run_id",
    "raw_file_sha256",
    "raw_row_number",
    "raw_side",
    "event_fingerprint_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "liquidated_position_side": {"enum": ["long", "short"]},
    "occurred_at_ms": {"type": "integer", "minimum": 1},
    "available_at_ms": {"type": "integer", "minimum": 1},
    "available_at_semantics": {
      "enum": [
        "vendor_capture_timestamp",
        "exchange_timestamp_fallback",
        "completed_interval"
      ]
    },
    "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "notional_usd": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "source_event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_event_id": {"type": ["string", "null"]},
    "dataset_origin": {"enum": ["historical_vendor", "synthetic_fixture"]},
    "historical_provider": {"type": "string", "minLength": 1},
    "provider_exchange": {"type": "string", "minLength": 1},
    "provider_timestamp_us": {"type": "integer", "minimum": 1},
    "provider_local_timestamp_us": {"type": ["integer", "null"], "minimum": 1},
    "native_channel": {"type": "string", "minLength": 1},
    "semantic_era": {"type": "string", "minLength": 1},
    "import_run_id": {"type": "string", "minLength": 1},
    "raw_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_row_number": {"type": "integer", "minimum": 1},
    "raw_side": {"type": "string", "minLength": 1},
    "event_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
