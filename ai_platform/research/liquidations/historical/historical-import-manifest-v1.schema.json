{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freqtrade.local/schemas/liquid20/historical-import-manifest-v1.schema.json",
  "title": "Liquid20 historical import manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_run_id",
    "provider_id",
    "requested_start_ms",
    "requested_end_ms",
    "symbols",
    "source_commit_sha",
    "parser_version",
    "decision_contract_sha256",
    "license_classification",
    "license_reference",
    "storage_root",
    "raw_files",
    "protected_holdout_start_ms",
    "protected_holdout_excluded",
    "created_at_utc",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "import_run_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "requested_start_ms": {"type": "integer", "minimum": 1},
    "requested_end_ms": {"type": "integer", "minimum": 1},
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "parser_version": {"type": "string", "minLength": 1},
    "decision_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "license_classification": {"type": "string", "minLength": 1},
    "license_reference": {"type": "string", "minLength": 1},
    "storage_root": {"type": "string", "minLength": 1},
    "raw_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256",
          "size_bytes",
          "provider_id",
          "provider_exchange",
          "symbol",
          "requested_date",
          "content_encoding",
          "parser_hint"
        ],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "provider_id": {"type": "string", "minLength": 1},
          "provider_exchange": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "requested_date": {"type": "string", "format": "date"},
          "content_encoding": {"type": "string", "minLength": 1},
          "parser_hint": {"type": "string", "minLength": 1}
        }
      }
    },
    "protected_holdout_start_ms": {"type": "integer", "minimum": 1},
    "protected_holdout_excluded": {"const": true},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
