{
  "$defs": {
    "dateRange": {
      "additionalProperties": false,
      "properties": {
        "end_exclusive": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "start_inclusive": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "required": [
        "start_inclusive",
        "end_exclusive"
      ],
      "type": "object"
    },
    "exchangeDataset": {
      "additionalProperties": false,
      "properties": {
        "exchange": {
          "type": "string"
        },
        "market_type": {
          "type": "string"
        },
        "native_symbols": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "normalized_symbols": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "semantic_eras": {
          "items": {
            "$ref": "#/$defs/semanticEraId"
          },
          "type": "array"
        }
      },
      "required": [
        "exchange",
        "market_type",
        "native_symbols",
        "normalized_symbols",
        "semantic_eras"
      ],
      "type": "object"
    },
    "semanticEra": {
      "additionalProperties": false,
      "properties": {
        "end_exclusive": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "id": {
          "$ref": "#/$defs/semanticEraId"
        },
        "start_inclusive": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "semanticEraId": {
      "enum": [
        "bybit-all-liquidation-exchange-contract-from-2025-02-20",
        "bybit-tardis-all-liquidation-v1-from-2025-02-26",
        "binance-force-order-realtime-before-2021-04-27",
        "binance-force-order-snapshot-1s-from-2021-04-27"
      ]
    },
    "sourceDecision": {
      "additionalProperties": false,
      "properties": {
        "authentication_requirement": {
          "type": "string"
        },
        "compression": {
          "type": "string"
        },
        "decision_status": {
          "type": "string"
        },
        "exchange": {
          "type": "string"
        },
        "expected_storage_category": {
          "enum": [
            "small",
            "medium",
            "large",
            "material"
          ]
        },
        "file_format": {
          "type": "string"
        },
        "granularity": {
          "type": "string"
        },
        "immutable_retention_permission": {
          "type": "string"
        },
        "licensing_classification": {
          "type": "string"
        },
        "market_type": {
          "type": "string"
        },
        "native_publication_semantics": {
          "type": "object"
        },
        "native_symbols": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "normalized_symbols": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "partitioning": {
          "type": "string"
        },
        "provider_capture_time_available": {
          "type": "boolean"
        },
        "provider_dataset_product_identity": {
          "type": "string"
        },
        "provider_identity": {
          "type": "string"
        },
        "recommended_date_range": {
          "oneOf": [
            {
              "$ref": "#/$defs/dateRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "redistribution_classification": {
          "type": "string"
        },
        "requested_date_range": {
          "$ref": "#/$defs/dateRange"
        },
        "semantic_conflicts": {
          "type": "array"
        },
        "semantic_eras": {
          "items": {
            "$ref": "#/$defs/semanticEra"
          },
          "type": "array"
        },
        "timestamp_fields": {
          "type": "object"
        },
        "unresolved_owner_decisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "verified_available_date_ranges": {
          "type": "object"
        }
      },
      "required": [
        "provider_identity",
        "provider_dataset_product_identity",
        "exchange",
        "market_type",
        "native_symbols",
        "normalized_symbols",
        "requested_date_range",
        "verified_available_date_ranges",
        "granularity",
        "native_publication_semantics",
        "timestamp_fields",
        "provider_capture_time_available",
        "semantic_eras",
        "semantic_conflicts",
        "compression",
        "file_format",
        "partitioning",
        "authentication_requirement",
        "licensing_classification",
        "redistribution_classification",
        "immutable_retention_permission",
        "expected_storage_category",
        "decision_status",
        "unresolved_owner_decisions"
      ],
      "type": "object"
    },
    "utcTimestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    }
  },
  "$id": "provider-decision-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "provider-decision-v1.schema.json"
    },
    "decision_package_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "type": "string"
    },
    "decision_status": {
      "enum": [
        "accepted",
        "rejected",
        "owner_action_required",
        "blocked"
      ]
    },
    "identity_material": {
      "additionalProperties": false,
      "properties": {
        "decision_package_id": {
          "type": "string"
        },
        "end_exclusive": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "exchanges": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "native_symbols": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "product": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "start_inclusive": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "required": [
        "decision_package_id",
        "provider",
        "product",
        "exchanges",
        "native_symbols",
        "start_inclusive",
        "end_exclusive",
        "schema_version"
      ],
      "type": "object"
    },
    "identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "owner_decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cost_category": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "required",
          "decision"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "preferred_provider": {
      "type": "string"
    },
    "provider_dependency_risks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "public_sample_evidence": {
      "type": "object"
    },
    "recommended_import_request": {
      "additionalProperties": false,
      "properties": {
        "authentication_requirement": {
          "type": "string"
        },
        "day_count": {
          "minimum": 1,
          "type": "integer"
        },
        "end_exclusive": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "exchange_datasets": {
          "items": {
            "$ref": "#/$defs/exchangeDataset"
          },
          "minItems": 1,
          "type": "array"
        },
        "expected_compressed_storage_bytes_sample_scaled": {
          "minimum": 1,
          "type": "integer"
        },
        "expected_uncompressed_storage_bytes_sample_scaled": {
          "minimum": 1,
          "type": "integer"
        },
        "file_partition": {
          "type": "string"
        },
        "owner_decision_required": {
          "type": "boolean"
        },
        "planning_storage_reservation_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "protected_final_holdout_excluded": {
          "const": true
        },
        "provider": {
          "type": "string"
        },
        "provider_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "provider_product": {
          "type": "string"
        },
        "purchase_requirement": {
          "type": "string"
        },
        "required_generated_manifests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "required_raw_integrity": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "start_inclusive": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "storage_category": {
          "enum": [
            "small",
            "medium",
            "large",
            "material"
          ]
        },
        "storage_estimate_basis": {
          "type": "string"
        },
        "synology_destination": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_product",
        "start_inclusive",
        "end_exclusive",
        "day_count",
        "exchange_datasets",
        "provider_file_count",
        "file_partition",
        "expected_compressed_storage_bytes_sample_scaled",
        "expected_uncompressed_storage_bytes_sample_scaled",
        "planning_storage_reservation_bytes",
        "storage_category",
        "synology_destination",
        "required_raw_integrity",
        "required_generated_manifests",
        "authentication_requirement",
        "purchase_requirement",
        "owner_decision_required",
        "protected_final_holdout_excluded"
      ],
      "type": "object"
    },
    "requested_date_range": {
      "$ref": "#/$defs/dateRange"
    },
    "schema_version": {
      "const": 1
    },
    "source_decisions": {
      "items": {
        "$ref": "#/$defs/sourceDecision"
      },
      "minItems": 2,
      "type": "array"
    },
    "source_urls": {
      "items": {
        "pattern": "^https://",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "pull_request": {
          "pattern": "^#[0-9]+$",
          "type": "string"
        },
        "sample_workflow_job_id": {
          "minimum": 1,
          "type": "integer"
        },
        "sample_workflow_run_id": {
          "minimum": 1,
          "type": "integer"
        },
        "verification_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "verified_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "required": [
        "verified_at",
        "verification_commit",
        "branch",
        "pull_request",
        "method"
      ],
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "decision_package_id",
    "identity_material",
    "identity_sha256",
    "verification",
    "decision_status",
    "preferred_provider",
    "requested_date_range",
    "recommended_import_request",
    "source_decisions",
    "public_sample_evidence",
    "owner_decisions",
    "provider_dependency_risks",
    "source_urls"
  ],
  "title": "Liquid20 historical provider decision",
  "type": "object"
}
