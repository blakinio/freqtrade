{
  "schema_version": 1,
  "policy_id": "liquid20-multi-source-acceptance-v1",
  "manifest_type": "liquidation_multi_source_collection",
  "profile_name": "liquid20-v1",
  "symbols": [
    "BTCUSDT",
    "ETHUSDT",
    "SOLUSDT",
    "XRPUSDT",
    "DOGEUSDT",
    "BNBUSDT",
    "ADAUSDT",
    "SUIUSDT",
    "LINKUSDT",
    "AVAXUSDT",
    "TRXUSDT",
    "DOTUSDT",
    "LTCUSDT",
    "BCHUSDT",
    "ETCUSDT",
    "APTUSDT",
    "NEARUSDT",
    "UNIUSDT",
    "FILUSDT",
    "ATOMUSDT"
  ],
  "minimum_duration_seconds": 86400,
  "requirements": {
    "execution_disabled": true,
    "trading_credentials_absent": true,
    "collector_commit": true,
    "new_output": true,
    "run_id": true,
    "host_id": true,
    "clock_synchronized_at_start_and_end": true
  },
  "cross_source": {
    "deduplicate_between_exchanges": false,
    "sum_events_without_source_labels": false,
    "minimum_union_observed_symbols": 12,
    "minimum_intersection_observed_symbols": 5
  },
  "sources": {
    "bybit-linear": {
      "endpoint": "wss://stream.bybit.com/v5/public/linear",
      "clock_endpoint": "https://api.bybit.com/v5/market/time",
      "stream": "allLiquidation",
      "coverage_semantics": "all liquidation events published by the exchange",
      "documented_push_frequency_ms": 500,
      "minimum_messages_received": 1,
      "maximum_parse_failures": 0,
      "minimum_availability_ratio": 0.995,
      "maximum_disconnects_per_hour": 2.0,
      "maximum_duplicate_ratio": 0.01,
      "latency_threshold_ms": 5000,
      "maximum_latency_over_threshold_ratio": 0.01,
      "minimum_latency_samples": 20,
      "minimum_events_total": 20,
      "minimum_observed_symbols": 8
    },
    "binance-usdm": {
      "endpoint": "wss://fstream.binance.com/market/ws",
      "clock_endpoint": "https://fapi.binance.com/fapi/v1/time",
      "stream": "forceOrder",
      "coverage_semantics": "latest liquidation order per symbol within each 1000 ms window",
      "documented_push_frequency_ms": 1000,
      "minimum_messages_received": 1,
      "maximum_parse_failures": 0,
      "minimum_availability_ratio": 0.995,
      "maximum_disconnects_per_hour": 2.0,
      "maximum_duplicate_ratio": 0.01,
      "latency_threshold_ms": 5000,
      "maximum_latency_over_threshold_ratio": 0.01,
      "minimum_latency_samples": 10,
      "minimum_events_total": 10,
      "minimum_observed_symbols": 5
    }
  },
  "boundary": "Acceptance authorizes immutable multi-source research evidence only. It does not authorize replay, strategy promotion, dry-run trading, order execution, DCA, leverage, protected-holdout use, or live capital."
}
