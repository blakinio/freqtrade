{
  "schema_version": 1,
  "policy_id": "okx-liquidation-shadow-acceptance-v1",
  "classification": "shadow_source_operational_acceptance",
  "source": "okx-usdt-swap",
  "symbols": [
    "BTCUSDT",
    "ETHUSDT"
  ],
  "minimum_duration_seconds": 86400,
  "host": {
    "required_class": "always_on_nonrestricted_linux_staging",
    "exact_host_id_required": true,
    "github_hosted_runner_allowed": false
  },
  "endpoints": {
    "websocket": "wss://ws.okx.com:8443/ws/v5/public",
    "clock": "https://www.okx.com/api/v5/public/time",
    "instruments": "https://www.okx.com/api/v5/public/instruments?instType=SWAP"
  },
  "source_semantics": {
    "channel": "liquidation-orders",
    "instrument_type": "SWAP",
    "coverage": "grouped liquidation orders published by OKX on the public SWAP channel",
    "quantity_normalization": "base_quantity = contracts * frozen_ctVal",
    "cross_exchange_deduplication": false
  },
  "thresholds": {
    "minimum_duration_seconds": 86400,
    "minimum_messages_received": 1,
    "minimum_control_messages": 1,
    "minimum_connections": 1,
    "maximum_parse_failures": 0,
    "maximum_invalid_normalized_events": 0,
    "minimum_availability_ratio": 0.995,
    "maximum_disconnects_per_hour": 2.0,
    "maximum_duplicate_ratio": 0.01,
    "latency_threshold_ms": 5000,
    "maximum_latency_over_threshold_ratio": 0.01,
    "minimum_latency_samples": 10,
    "minimum_events_total": 10,
    "minimum_observed_symbols": 1,
    "minimum_events_per_observed_symbol": 1,
    "clock_tolerance_ms": 2000
  },
  "requirements": {
    "execution_enabled": false,
    "trading_credentials_present": false,
    "performance_research_authorized": false,
    "replay_authorized": false,
    "model_training_authorized": false,
    "orders_submitted": 0,
    "new_output": true,
    "collector_commit": true,
    "run_id": true,
    "host_id": true,
    "clock_synchronized_at_start_and_end": true,
    "instrument_snapshot": true,
    "manifest_self_hash": true,
    "report_self_hash": true,
    "checksum_index": true,
    "durable_raw_package": true
  },
  "durability": {
    "raw_events_required": true,
    "summary_required": true,
    "instrument_snapshot_required": true,
    "manifest_required": true,
    "report_required": true,
    "checksum_index_required": true,
    "immutable_storage_uri_required": true,
    "ephemeral_ci_artifact_alone_is_sufficient": false,
    "retention_rule": "retain immutably until an explicit evidence-retirement task is merged"
  },
  "outcomes": {
    "accepted": "Every safety, identity, clock, health, activity, normalization, latency and artifact-integrity gate passes.",
    "rejected": "Any safety, identity, clock, health, normalization, latency or artifact-integrity gate fails.",
    "inconclusive_insufficient_activity": "All non-activity gates pass, but one or more minimum activity or latency-sample gates are not met. This outcome does not accept or reject source quality."
  },
  "boundary": "Acceptance authorizes only a later proposal to use the immutable OKX shadow evidence for source-integration research. It does not add OKX to liquid20-v1, authorize replay, model work, performance claims, strategy promotion, order execution, DCA, leverage, protected-holdout use or live capital."
}
