    "maximum_parse_failures": 0,
    "minimum_availability_ratio": 0.9,
    "maximum_disconnects": 1,
    "maximum_duplicate_ratio": 0.01,
    "latency_threshold_ms": 10000,
    "maximum_latency_over_threshold_ratio": 0.05,
    "minimum_events_total": 0,
    "minimum_observed_symbols": 0,
    "clock_tolerance_ms": 2000
  },
  "requirements": {
    "execution_enabled": false,
    "trading_credentials_present": false,
    "performance_research_authorized": false,
    "orders_submitted": 0,
    "new_output": true,
    "collector_commit": true,
    "instrument_snapshot": true
