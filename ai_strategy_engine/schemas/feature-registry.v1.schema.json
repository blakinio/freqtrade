{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inwestycja.local/schemas/feature-registry.v1.schema.json",
  "title": "Feature Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "features"],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "parameterType": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["integer", "number", "string", "boolean", "null", "array"]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["integer", "number", "string", "boolean", "null", "array"]
          }
        }
      ]
    },
    "arrayItems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["integer", "number", "string", "boolean"]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "$ref": "#/$defs/parameterType"
        },
        "default": true,
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array"
        },
        "items": {
          "$ref": "#/$defs/arrayItems"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "approved_for_ai",
        "roles",
        "inputs",
        "parameters",
        "warmup",
        "timestamp_policy",
        "license_origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.v[0-9]+$"
        },
        "status": {
          "type": "string",
          "enum": ["validated", "experimental", "research"]
        },
        "approved_for_ai": {
          "type": "boolean"
        },
        "research_only": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warmup": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "timestamp_policy": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "normalization_policy": {
          "type": "string",
          "minLength": 1
        },
        "license_origin": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": ["normalization"]
        },
        {
          "required": ["normalization_policy"]
        }
      ]
    }
  }
}
