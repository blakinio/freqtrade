{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "event": {"type": "null"},
            "feature": {"minLength": 1, "type": "string"},
            "risk": {"type": "null"}
          },
          "required": ["feature"]
        },
        {
          "properties": {
            "event": {"minLength": 1, "type": "string"},
            "feature": {"type": "null"},
            "risk": {"type": "null"}
          },
          "required": ["event"]
        },
        {
          "properties": {
            "event": {"type": "null"},
            "feature": {"type": "null"},
            "risk": {"minLength": 1, "type": "string"}
          },
          "required": ["risk"]
        }
      ],
      "properties": {
        "direction": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "title": "Direction"
        },
        "event": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "title": "Event"
        },
        "feature": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "title": "Feature"
        },
        "op": {
          "anyOf": [{"$ref": "#/$defs/ConditionOperator"}, {"type": "null"}],
          "default": null
        },
        "parameter": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "title": "Parameter"
        },
        "risk": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "title": "Risk"
        },
        "value": {"$ref": "#/$defs/JsonValue", "default": null}
      },
      "title": "Condition",
      "type": "object"
    },
    "ConditionGroup": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {"$ref": "#/$defs/Condition"},
                  {"$ref": "#/$defs/ConditionGroup"}
                ]
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "default": null,
          "title": "All"
        },
        "any": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {"$ref": "#/$defs/Condition"},
                  {"$ref": "#/$defs/ConditionGroup"}
                ]
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "default": null,
          "title": "Any"
        },
        "none": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {"$ref": "#/$defs/Condition"},
                  {"$ref": "#/$defs/ConditionGroup"}
                ]
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "default": null,
          "title": "None"
        }
      },
      "title": "ConditionGroup",
      "type": "object"
    },
    "ConditionOperator": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "gte",
        "lt",
        "lte",
        "crosses_above",
        "crosses_below",
        "in_range",
        "bars_since_lte"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "FeatureReference": {
      "additionalProperties": false,
      "properties": {
        "confirmation": {
          "enum": ["closed_bar", "confirmed_htf"],
          "title": "Confirmation",
          "type": "string"
        },
        "id": {"minLength": 1, "title": "Id", "type": "string"},
        "params": {
          "additionalProperties": {"$ref": "#/$defs/JsonValue"},
          "title": "Params",
          "type": "object"
        },
        "timeframe": {"minLength": 1, "title": "Timeframe", "type": "string"}
      },
      "required": ["id", "timeframe", "confirmation"],
      "title": "FeatureReference",
      "type": "object"
    },
    "JsonValue": {},
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {"$ref": "#/$defs/JsonValue"},
          "title": "Details",
          "type": "object"
        },
        "lineage": {
          "default": [],
          "items": {"minLength": 1, "type": "string"},
          "title": "Lineage",
          "type": "array"
        },
        "producer": {"minLength": 1, "title": "Producer", "type": "string"},
        "source_event_id": {
          "minLength": 1,
          "title": "Source Event Id",
          "type": "string"
        }
      },
      "required": ["producer", "source_event_id"],
      "title": "Provenance",
      "type": "object"
    },
    "StrategyUniverse": {
      "additionalProperties": false,
      "properties": {
        "symbols": {
          "items": {"minLength": 1, "type": "string"},
          "title": "Symbols",
          "type": "array"
        },
        "timeframes": {
          "items": {"minLength": 1, "type": "string"},
          "title": "Timeframes",
          "type": "array"
        }
      },
      "required": ["symbols", "timeframes"],
      "title": "StrategyUniverse",
      "type": "object"
    }
  },
  "$id": "https://schemas.inwestycja.local/strategy-definition.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entry_long": {"$ref": "#/$defs/ConditionGroup"},
    "entry_short": {
      "anyOf": [{"$ref": "#/$defs/ConditionGroup"}, {"type": "null"}],
      "default": null
    },
    "execution": {
      "additionalProperties": {"$ref": "#/$defs/JsonValue"},
      "title": "Execution",
      "type": "object"
    },
    "exit": {"$ref": "#/$defs/ConditionGroup"},
    "features": {
      "items": {"$ref": "#/$defs/FeatureReference"},
      "title": "Features",
      "type": "array"
    },
    "provenance": {"$ref": "#/$defs/Provenance"},
    "regime": {
      "anyOf": [{"$ref": "#/$defs/ConditionGroup"}, {"type": "null"}],
      "default": null
    },
    "risk": {
      "additionalProperties": {"$ref": "#/$defs/JsonValue"},
      "title": "Risk",
      "type": "object"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_id": {"minLength": 1, "title": "Strategy Id", "type": "string"},
    "universe": {"$ref": "#/$defs/StrategyUniverse"},
    "version": {"minLength": 1, "title": "Version", "type": "string"}
  },
  "required": [
    "strategy_id",
    "version",
    "universe",
    "features",
    "entry_long",
    "exit",
    "risk",
    "execution",
    "provenance"
  ],
  "title": "StrategyDefinition",
  "type": "object"
}
