# Copy to .env only when updating or registering the dedicated Freqtrade runner.
# Preserve the existing runner_config volume when replacing the current project.
# A one-time RUNNER_TOKEN is required only when the persistent registration is absent.
RUNNER_IMAGE=ghcr.io/blakinio/freqtrade-deploy-runner:develop
RUNNER_NAME=freqtrade-synology-staging
RUNNER_TOKEN=
FREQTRADE_STATE_HOST_PATH=/volume1/docker/freqtrade/state
