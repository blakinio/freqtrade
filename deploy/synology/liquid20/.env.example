# Exact commit checked out in this repository. Obtain with: git rev-parse HEAD
COLLECTOR_COMMIT=REPLACE_WITH_40_CHARACTER_GIT_SHA
IMAGE_TAG=liquid20-v1

# Synology account that owns ./data. Obtain with: id YOUR_DSM_USER
PUID=1026
PGID=100

# Stable, non-sensitive identifier recorded in the evidence package.
HOST_ID=synology-pl-01

# First deploy as smoke. Change to acceptance only after the smoke artifacts are checked.
MODE=smoke
SMOKE_DURATION_SECONDS=60

# Leave empty to generate a unique UTC run identifier at container startup.
RUN_ID=
