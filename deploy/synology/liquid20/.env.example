# Exact commit checked out in this repository. Obtain with: git rev-parse HEAD
COLLECTOR_COMMIT=REPLACE_WITH_40_CHARACTER_GIT_SHA
IMAGE_TAG=liquid20-live-v1

# Synology account that owns ./data. Obtain with: id YOUR_DSM_USER
PUID=1026
PGID=100

# Stable, non-sensitive identifier recorded in the live-state contract.
HOST_ID=synology-pl-01

# Continuous live/shadow collector controls.
LIVE_HEARTBEAT_SECONDS=5
SYMBOL_REFRESH_SECONDS=3600
MAXIMUM_SYMBOLS=1000

# One-shot immutable evidence collection remains a separate opt-in Compose profile.
MODE=smoke
SMOKE_DURATION_SECONDS=60
RUN_ID=
