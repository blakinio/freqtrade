# Copy to a chmod-600 file outside Git. validate.py rejects these placeholders.
AUTHENTIK_IMAGE=docker.io/authentik/server:2026.5.5@sha256:50a833c48a714709f15d4f8846ec6b81a41d0d6a6bd2975087dfed3000d0d72e
POSTGRES_IMAGE=docker.io/library/postgres:16.13-alpine3.23@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777

AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
AUTHENTIK_SECRET_KEY=REPLACE_WITH_RANDOM_AUTHENTIK_SECRET_KEY

# The only host-published listener. Keep loopback-only; an owner-managed tunnel or
# reverse proxy can reach it on the Synology host without exposing the database.
AUTHENTIK_BIND_ADDRESS=127.0.0.1
AUTHENTIK_HTTP_PORT=9000

# Must remain empty during steady-state operation. bootstrap.sh injects the hash
# from a separate one-shot file and recreates server/worker without it.
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH=
