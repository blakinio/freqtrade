FROM python:3.13.14-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get upgrade --yes \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 portal \
    && useradd --uid 10001 --gid portal --home-dir /nonexistent --no-create-home portal

WORKDIR /app

COPY deploy/synology/portal-oidc/requirements.txt /tmp/portal-identity-requirements.txt
RUN pip install --no-cache-dir --requirement /tmp/portal-identity-requirements.txt \
    && rm -f /tmp/portal-identity-requirements.txt

COPY --chown=portal:portal ai_platform /app/ai_platform
COPY --chown=portal:portal ai_strategy_engine/src/strategy_engine /app/strategy_engine
COPY deploy/synology/portal-oidc/control-plane-entrypoint.sh /usr/local/bin/portal-control-plane-entrypoint
RUN chmod 0555 /usr/local/bin/portal-control-plane-entrypoint

USER portal

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/readyz', timeout=4).read()"

ENTRYPOINT ["/usr/local/bin/portal-control-plane-entrypoint"]
CMD ["uvicorn", "ai_platform.portal.identity.public_runtime:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
