FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY ai_platform/portal/web/package.json ai_platform/portal/web/package-lock.json ./
RUN npm ci
COPY ai_platform/portal/web/e2e/wickhunter-api-mode-ci.mjs ./e2e/wickhunter-api-mode-ci.mjs
RUN chown -R node:node /app

USER node
ENTRYPOINT ["node", "/app/e2e/wickhunter-api-mode-ci.mjs"]
