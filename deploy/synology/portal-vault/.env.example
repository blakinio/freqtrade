# Copy outside Git to a chmod-600 runtime env file.
VAULT_IMAGE=docker.io/hashicorp/vault:2.0.3@sha256:a296a888b118615dc01d5f1a6846e6d4a7277946caaed5b447008fff5fe06b54

# Owner-managed host directories. Never place private keys, operator tokens or
# AppRole SecretIDs inside the repository checkout.
VAULT_TLS_DIRECTORY=/volume1/docker/portal-vault/tls
VAULT_OPERATOR_DIRECTORY=/volume1/docker/portal-vault/operator
VAULT_APPROLE_OUTPUT_DIRECTORY=/volume1/docker/portal-vault/approle
