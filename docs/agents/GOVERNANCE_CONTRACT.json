{
  "schema_version": 3,
  "policy_revision": 3,
  "contract_name": "portable-agent-checkpoint-handoff",
  "compatibility": "checkpoint version 2 adds durable per-task exact-SHA observation history while retaining version 1 read compatibility",
  "shared_checkpoint_contract": {
    "version": 2,
    "accepted_versions": [
      1,
      2
    ],
    "required_fields": [
      "checkpoint_version",
      "updated_at",
      "head",
      "branch",
      "pr",
      "status",
      "context_routes",
      "owned_paths",
      "proven",
      "derived",
      "unknown",
      "conflicts",
      "first_failure",
      "rejected_hypotheses",
      "changed_paths",
      "validation",
      "blockers",
      "next_action"
    ],
    "version_2_required_fields": [
      "ci_checks_for_current_head",
      "review_checks_for_current_head",
      "observation_counters_by_sha"
    ],
    "observation_counter_contract": {
      "field": "observation_counters_by_sha",
      "key_format": "lowercase_40_hex_exact_commit_sha",
      "required_counter_keys": [
        "ci",
        "review"
      ],
      "max_exact_heads": 32,
      "current_head_ci_scalar": "ci_checks_for_current_head",
      "current_head_review_scalar": "review_checks_for_current_head",
      "reset_rule": "only_a_genuinely_new_exact_commit_sha_gets_a_new_counter_entry",
      "return_to_prior_sha_rule": "reuse_the_existing_counter_entry_for_that_task_and_sha"
    },
    "allowed_statuses": [
      "investigating",
      "implementing",
      "validating",
      "ready",
      "waiting",
      "blocked",
      "completed"
    ],
    "allowed_validation_results": [
      "PASS",
      "FAIL",
      "BLOCKED",
      "NOT_RUN",
      "NOT_APPLICABLE"
    ],
    "terminal_invocation_results": [
      "DONE",
      "WAITING",
      "BLOCKED",
      "ROTATE"
    ],
    "evidence_state_fields": {
      "PROVEN": "proven",
      "DERIVED": "derived",
      "UNKNOWN": "unknown",
      "CONFLICT": "conflicts"
    },
    "compactness_limits": {
      "context_routes": 8,
      "owned_paths": 64,
      "proven": 16,
      "derived": 12,
      "unknown": 12,
      "conflicts": 8,
      "rejected_hypotheses": 16,
      "changed_paths": 32,
      "validation": 12,
      "blockers": 8
    },
    "rules": [
      "ROTATE is a terminal invocation result and never a checkpoint task status.",
      "Before returning ROTATE, persist ready, waiting or blocked with one concrete next_action.",
      "NOT_APPLICABLE requires a concrete evidence reason.",
      "Checkpoint version 1 remains readable only for legacy records that have not migrated to durable observation history.",
      "Any checkpoint version 2 record must persist CI and review observations in observation_counters_by_sha keyed by exact commit SHA.",
      "For version 2, current-head scalar counters must equal the current head entry in observation_counters_by_sha.",
      "Returning from SHA B to previously observed SHA A reuses SHA A counters; owner invocation, Chat replacement, rerun and check-generation changes never reset them."
    ]
  }
}
