{
  "schema_version": 1,
  "authority": "ADR-023",
  "scope": "repository-changing tasks",
  "integration_branch": "develop",
  "baseline_gates": [
    "live_state_and_scope",
    "dedicated_branch_when_writing",
    "focused_validation",
    "pull_request_to_develop",
    "exact_head_relevant_ci",
    "truthful_outcome_verification",
    "squash_merge",
    "source_branch_cleanup",
    "secrets_excluded",
    "no_real_capital_without_separate_authority"
  ],
  "checkpoint_required_when": [
    "multi_agent",
    "multi_session",
    "long_running",
    "failure_prone",
    "shared_state_mutation",
    "destructive_operation"
  ],
  "risk_dimensions": {
    "persistent_data": {
      "gates": [
        "persistence_or_migration_validation",
        "restart_and_recovery_validation"
      ]
    },
    "research_integrity": {
      "gates": [
        "data_provenance_validation",
        "leakage_and_lookahead_validation",
        "evaluation_integrity_validation",
        "independent_audit"
      ]
    },
    "model_activation": {
      "gates": [
        "immutable_model_identity",
        "deliberate_activation",
        "rollback_or_reversibility",
        "independent_audit"
      ]
    },
    "auth_or_secrets": {
      "gates": [
        "targeted_security_and_secret_boundary_validation",
        "independent_audit"
      ]
    },
    "shared_synology_mutation": {
      "gates": [
        "bounded_resource_ownership",
        "pre_and_post_health_validation",
        "durable_state_and_recovery_validation",
        "independent_audit"
      ]
    },
    "deployment": {
      "gates": [
        "artifact_or_image_provenance",
        "target_specific_acceptance",
        "independent_audit"
      ]
    },
    "user_workflow_change": {
      "gates": [
        "real_applicable_e2e"
      ]
    },
    "destructive_operation": {
      "gates": [
        "exact_resource_identity",
        "ownership_validation",
        "backup_or_recovery_path",
        "fail_closed_execution",
        "independent_audit"
      ]
    },
    "real_capital": {
      "gates": [],
      "stop": true,
      "reason": "Real-capital execution requires a separate owner-approved Execution/Capital Gateway architecture and programme."
    },
    "governance_or_ci": {
      "gates": [
        "policy_regression",
        "trusted_base_self_validation",
        "independent_audit"
      ]
    }
  }
}
