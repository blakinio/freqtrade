        "protected_holdout_check",
        "performance_research_authorized",
        "manifest_sha256"
      ],
      "rules": {
        "performance_research_authorized_true_requires": [
          "every selected performance interval is covered by a final report with passed true",
          "all required source and candle files have immutable hashes",
          "protected holdout policy passes",
          "no unresolved source clock or interval-integrity failure"
        ]
      },
      "example": "docs/ai_platform/portal/examples/liquidations-dataset-selection-v1.example.json"
    },
